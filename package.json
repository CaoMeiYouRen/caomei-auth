{
  "name": "caomei-auth",
  "private": true,
  "type": "module",
  "scripts": {
    "ai:check": "node scripts/ai/check-governance.mjs",
    "migration:usage": "node scripts/migration/primevue-usage.mjs",
    "migration:check-imports": "node scripts/migration/check-caomei-imports.mjs",
    "migration:measure": "node scripts/migration/measure-bundle.mjs",
    "migration:check-budget": "node scripts/migration/check-bundle-budget.mjs",
    "i18n:audit": "node scripts/i18n/audit-locale-keys.mjs",
    "i18n:audit:missing": "node scripts/i18n/audit-locale-keys.mjs --only=missing --fail-on-missing",
    "i18n:audit:duplicates": "node scripts/i18n/audit-duplicate-messages.mjs",
    "i18n:audit:hardcoded": "node scripts/i18n/audit-hardcoded-text.mjs",
    "i18n:audit:hardcoded:update": "node scripts/i18n/audit-hardcoded-text.mjs --update",
    "i18n:check-sync": "node scripts/i18n/check-locale-parity.mjs",
    "i18n:check-fallback": "node scripts/i18n/check-locale-fallback.mjs",
    "i18n:check": "pnpm i18n:audit:missing && pnpm i18n:check-sync && pnpm i18n:check-fallback && pnpm i18n:audit:hardcoded",
    "security:alerts": "node scripts/security/check-alerts.mjs",
    "setup:ai": "node scripts/setup-ai.mjs",
    "setup:switch-models": "node scripts/setup/switch-models.mjs",
    "setup:switch-models:list": "node scripts/setup/switch-models.mjs --list",
    "lint:css": "stylelint ./**/*.{css,scss,sass,vue} --fix",
    "lint:duplicate": "jscpd .",
    "lint:md": "lint-md *.md docs/**/*.md .github/**/*.md --fix",
    "lint": "cross-env NODE_ENV=production eslint . --fix",
    "release": "semantic-release",
    "build": "nuxt build",
    "build:debug": "cross-env DEBUG_BUILD=true nuxt build",
    "dev": "nuxt dev --open",
    "generate": "nuxt generate",
    "generate:debug": "cross-env DEBUG_BUILD=true nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "commit": "cz",
    "prepare": "husky install",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:visual": "node scripts/testing/run-visual.mjs",
    "test:visual:update": "node scripts/testing/run-visual.mjs --update",
    "test:visual:parity": "node scripts/testing/run-visual.mjs --parity",
    "test:visual:reference": "node scripts/testing/run-visual.mjs --reference",
    "test:visual:raw": "playwright test --config=playwright.visual.config.ts",
    "test:visual:raw:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:visual:parity:raw": "playwright test --config=playwright.visual-parity.config.ts",
    "test:visual:reference:raw": "cross-env VISUAL_REFERENCE_CAPTURE=1 playwright test --config=playwright.visual-parity.config.ts --update-snapshots",
    "docs:dev": "vitepress dev --open",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@axiomhq/winston": "^2.0.0",
    "@better-auth/oauth-provider": "1.7.17",
    "@better-auth/sso": "1.7.17",
    "@hcaptcha/vue3-hcaptcha": "^1.3.0",
    "@mdi/font": "^7.4.47",
    "@microsoft/clarity": "^1.0.2",
    "@nuxtjs/i18n": "10.6.0",
    "@primeuix/styled": "0.7.4",
    "@primeuix/styles": "^2.0.3",
    "@primeuix/themes": "^2.0.3",
    "@primeuix/utils": "0.6.4",
    "@primevue/core": "^4.5.5",
    "@primevue/forms": "^4.5.5",
    "@sentry/nuxt": "^10.71.0",
    "@vercel/blob": "^2.8.2",
    "@vueuse/core": "^15.0.0",
    "animate.css": "^4.1.1",
    "better-auth": "~1.7.17",
    "better-auth-localization": "^4.0.0",
    "better-bytes": "^1.2.6",
    "better-sqlite3": "^12.11.1",
    "caomei-ui": "1.2.0",
    "chart.js": "^4.6.1",
    "dayjs": "^1.11.23",
    "file-type": "^22.3.0",
    "fs-extra": "^11.4.1",
    "google-libphonenumber": "^3.2.48",
    "ioredis": "^5.11.1",
    "lodash-es": "^4.18.1",
    "lru-cache": "^11.5.3",
    "mime-types": "^3.0.2",
    "mjml": "^5.4.1",
    "ms": "^4.0.0-nightly.202508271359",
    "mysql2": "^3.24.6",
    "nest-winston": "^2.0.0",
    "nodemailer": "^10.3.1",
    "normalize.css": "^8.0.1",
    "nuxt": "^4.6.4",
    "p-queue": "^10.0.0",
    "pg": "^8.23.1",
    "pinia": "^4.1.0",
    "primelocale": "^2.6.2",
    "primevue": "^4.5.5",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.1",
    "twilio": "^6.2.0",
    "typeorm": "^0.3.31",
    "ua-parser-js": "^2.0.10",
    "validator": "^13.15.35",
    "vue": "^3.5.44",
    "vue-recaptcha": "^3.0.0-alpha.6",
    "vue-router": "^5.4.0",
    "vue-turnstile": "^1.0.11",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lint-md/cli": "^2.5.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "1.64.1",
    "@primevue/nuxt-module": "^4.5.5",
    "@types/fs-extra": "^11.0.4",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/lodash-es": "^4.17.12",
    "@types/mjml": "5.4.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/ua-parser-js": "^0.7.39",
    "@types/validator": "^13.15.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "commitizen": "^4.3.1",
    "commitlint": "^21.2.4",
    "commitlint-config-cmyr": "^1.0.0",
    "conventional-changelog-cmyr-config": "^3.0.0",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog-cmyr": "^2.0.0",
    "eslint": "^9.39.2",
    "eslint-config-cmyr": "^2.3.1",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "lint-staged": "^17.6.0",
    "pkg-types": "^2.4.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.32",
    "sass": "^1.107.1",
    "semantic-release": "^25.0.9",
    "semantic-release-cmyr-config": "^1.1.0",
    "stylelint": "^16.26.1",
    "stylelint-config-cmyr": "^1.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "author": "CaoMeiYouRen",
  "description": "草梅 Auth 是一个基于 Nuxt 全栈框架的统一登录平台。支持 OAuth2.0 协议，集成邮箱、用户名、手机号、验证码、社交媒体等多种登录注册方式。",
  "keywords": [
    "oauth2.0",
    "unified-login",
    "ssr",
    "better-auth",
    "nodemailer",
    "email-verification",
    "sms-verification",
    "social-login",
    "github",
    "google",
    "scss",
    "@mdi/font",
    "pnpm",
    "docker",
    "vercel",
    "cloudflare-workers",
    "multi-factor-authentication",
    "user-management",
    "api",
    "sso",
    "vue",
    "vue3",
    "nuxt"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "homepage": "https://github.com/CaoMeiYouRen/caomei-auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaoMeiYouRen/caomei-auth.git"
  },
  "bugs": {
    "url": "https://github.com/CaoMeiYouRen/caomei-auth/issues"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog-cmyr"
    }
  },
  "changelog": {
    "language": "zh"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "npm run lint",
      "git add"
    ],
    "i18n/locales/**/*.json": [
      "node scripts/i18n/audit-locale-keys.mjs --only=missing --fail-on-missing",
      "node scripts/i18n/check-locale-parity.mjs"
    ],
    "{app.vue,pages/**/*.vue,components/**/*.vue,layouts/**/*.vue,composables/**/*.ts,server/api/**/*.ts,server/utils/**/*.ts,server/routes/**/*.ts,server/middleware/**/*.ts,server/templates/**/*.{ts,mjml}}": [
      "node scripts/i18n/audit-hardcoded-text.mjs"
    ]
  },
  "version": "1.16.0",
  "packageManager": "pnpm@11.17.0"
}
