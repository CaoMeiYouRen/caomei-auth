{
    "$schema": "https://opencode.ai/config.json",
    "model": "opencode-go/deepseek-v4-flash",
    "default_agent": "full-stack-master",
    "instructions": [
        "AGENTS.md"
    ],
    "agent": {
        "full-stack-master": {
            "mode": "primary",
            "description": "默认开发主责角色，驱动 PDTFC 全循环，负责需求分析、方案设计、前后端实现与最终提交。",
            "prompt": "{file:.github/agents/full-stack-master.agent.md}",
            "model": "opencode-go/deepseek-v4-flash",
            "variant": "max"
        },
        "product-manager": {
            "mode": "subagent",
            "description": "需求守门员，负责需求挖掘、意图抽离、范围判断、验收标准定义与路线图对齐。",
            "prompt": "{file:.github/agents/product-manager.agent.md}",
            "model": "opencode-go/deepseek-v4-pro",
            "variant": "max"
        },
        "code-auditor": {
            "mode": "subagent",
            "description": "Review Gate 负责人，对代码、文档、配置、脚本与治理定义执行结构化审查，输出 Pass/Reject 结论。",
            "prompt": "{file:.github/agents/code-auditor.agent.md}",
            "model": "opencode-go/deepseek-v4-pro",
            "variant": "max"
        },
        "test-engineer": {
            "mode": "subagent",
            "description": "测试主责角色，负责测试补强、回归验证与覆盖率提升。",
            "prompt": "{file:.github/agents/test-engineer.agent.md}",
            "model": "opencode-go/deepseek-v4-flash",
            "variant": "max"
        },
        "ui-validator": {
            "mode": "subagent",
            "description": "浏览器验证角色，负责在真实渲染环境中确认 UI 变更的可用性、响应式与主题表现。",
            "prompt": "{file:.github/agents/ui-validator.agent.md}",
            "model": "opencode-go/qwen3.7-plus"
        },
        "qa-assistant": {
            "mode": "subagent",
            "description": "只读问答角色，负责基于现有代码和文档回答问题、定位信息并解释架构。严禁修改代码。",
            "prompt": "{file:.github/agents/qa-assistant.agent.md}",
            "model": "opencode-go/deepseek-v4-flash",
            "variant": "low"
        },
        "documentation-specialist": {
            "mode": "subagent",
            "description": "文档资产守护者，负责设计文档、规范文档与 README/Plan 的同步维护。",
            "prompt": "{file:.github/agents/documentation-specialist.agent.md}",
            "model": "opencode-go/deepseek-v4-flash",
            "variant": "medium"
        }
    }
}